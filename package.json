{
  "name": "content-studio",
  "version": "0.24.0",
  "description": "布谷AI内容工厂桌面应用，用于知识库、提示词、图片、视频和文章生产。",
  "type": "module",
  "main": "out/main/index.js",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build-local.mjs",
    "build:production": "node scripts/build-production.mjs",
    "start": "electron-vite preview",
    "dist": "npm run build:production && electron-builder --config electron-builder.yml",
    "forge:package": "npm run build:production && electron-forge package",
    "forge:make": "npm run build:production && electron-forge make",
    "forge:make:mac": "npm run build:production && electron-forge make --platform darwin",
    "forge:make:win": "npm run build:production && electron-forge make --platform win32",
    "forge:make:linux": "npm run build:production && electron-forge make --platform linux",
    "forge:publish": "npm run build:production && electron-forge publish",
    "oem:prepare": "node scripts/prepare-oem-build.mjs",
    "oem:clean": "node scripts/clean-oem-build.mjs",
    "oem:assert": "node scripts/assert-oem-artifact-scope.mjs",
    "oem:r2:publish": "node scripts/publish-oem-r2-release.mjs",
    "oem:release:verify-online": "node scripts/verify-oem-release-online.mjs",
    "content:release:verify-online": "node scripts/verify-content-knowledge-release-online.mjs",
    "content:team:verify-online": "node scripts/verify-content-team-sharing-online.mjs",
    "content:v1:verify-online": "node scripts/verify-content-ontology-v1-online.mjs",
    "content:v1:verify-report": "node scripts/verify-content-ontology-v1-report.mjs",
    "content:v1:verify-readiness": "node scripts/verify-content-ontology-v1-readiness.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.lime-packages.json",
    "assert:agent-runtime-packages": "node scripts/assert-agent-runtime-packages.mjs",
    "assert:local-lime-agent-runtime-tarballs": "node scripts/assert-local-lime-agent-runtime-tarballs.mjs",
    "check:lime-agent-runtime-npm-publish-readiness": "node scripts/check-lime-agent-runtime-npm-publish-readiness.mjs",
    "assert:desktop-platform-packages": "node scripts/assert-desktop-platform-packages.mjs",
    "dist:mac": "npm run build:production && electron-builder --config electron-builder.yml --mac dmg zip --publish never",
    "dist:win": "npm run build:production && electron-builder --config electron-builder.yml --win nsis --publish never",
    "dist:linux": "npm run build:production && electron-builder --config electron-builder.yml --linux AppImage --publish never",
    "smoke:electron": "node scripts/electron-smoke.mjs",
    "smoke:electron:headed": "node scripts/electron-smoke.mjs --headed",
    "smoke:app-server": "node scripts/app-server-smoke.mjs",
    "app-server:prepare": "node scripts/prepare-app-server-resources.mjs",
    "app-server:prepare:release": "node scripts/prepare-app-server-resources.mjs",
    "app-server:prepare:test": "node --test scripts/prepare-app-server-resources.test.mjs",
    "app-server:backend:test": "node --test scripts/app-server-backend.test.mjs",
    "app-server:backend:live": "node scripts/app-server-backend-live-check.mjs",
    "app-server:runtime:live": "node scripts/app-server-runtime-live-check.mjs",
    "platform-host:runtime:live": "node scripts/platform-host-runtime-live-check.mjs",
    "verify:lime-agent": "node scripts/lime-agent-boundary-audit.mjs",
    "verify:v2:providers": "node scripts/v2-provider-check.mjs",
    "verify:v2:providers:strict": "node scripts/v2-provider-check.mjs --strict",
    "verify:v2:acceptance": "node scripts/run-v2-business-acceptance.mjs",
    "verify:v2:evidence": "node scripts/run-v2-acceptance-evidence.mjs",
    "verify:v2:ux-copy": "node scripts/v2-ux-copy-audit.mjs",
    "verify:v2:release": "node scripts/run-v2-acceptance-evidence.mjs --provider-strict --require-real-workspace-evidence --require-external-mix-evidence --allow-network --allow-media",
    "verify:v2": "npm run verify:v2:providers && npm run verify:v2:acceptance && npm run verify:v2:ux-copy",
    "test:functional": "node scripts/run-functional-tests.mjs",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "test:e2e:headed": "npm run test:e2e -- --headed",
    "verify:local": "npm run typecheck && npm run content:v1:verify-readiness && npm run build && npm run verify:v2 && npm run verify:lime-agent && npm run test:functional && npm run smoke:electron && npm run test:e2e"
  },
  "dependencies": {
    "@limecloud/agent-capability-catalog": "0.1.0",
    "@limecloud/agent-runtime-client": "0.1.1",
    "@limecloud/agent-runtime-projection": "^0.1.1",
    "@limecloud/agent-runtime-ui": "^0.1.1",
    "@limecloud/agent-workbench-adapter": "0.1.0",
    "@limecloud/desktop-platform-contracts": "^0.2.2",
    "@limecloud/desktop-platform-electron-adapter": "^0.2.6",
    "@limecloud/desktop-platform-react": "^0.2.1",
    "@types/yauzl": "^2.10.3",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.8.0",
    "gray-matter": "^4.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "yauzl": "^3.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@playwright/test": "1.60.0",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "undici": "7.25.0"
  },
  "author": "布谷AI"
}
