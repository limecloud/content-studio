:root {
  --bg: #F8F9FA;
  --panel: #FFFFFF;
  --panel-strong: #F3F4F6;
  --line: #E5E7EB;
  --text: #111827;
  --text-secondary: #4B5563;
  --muted: #9CA3AF;
  --cyan: #395745;
  --cyan-light: rgba(57, 87, 69, 0.08);
  --pink: #4B5563;
  --green: #395745;
  --danger: #EF4444;
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
  --shadow-lg: 0 10px 25px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --radius-sm: 6px;
  --radius: 10px;
  --radius-lg: 14px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  min-width: 1200px;
  min-height: 100vh;
  overflow: hidden;
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
  color: var(--text);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
}

button, input, textarea, select { font: inherit; }
button { border: 0; color: inherit; cursor: pointer; background: transparent; }
button:disabled { cursor: not-allowed; opacity: 0.5; }

input, textarea, select {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  color: var(--text);
  background: #FFFFFF;
  outline: none;
  padding: 10px 12px;
  font-size: 13px;
  transition: all 0.2s ease;
  box-shadow: var(--shadow-sm);
}
input:focus, textarea:focus {
  border-color: var(--cyan);
  box-shadow: 0 0 0 2px var(--cyan-light);
}
textarea { min-height: 140px; resize: vertical; line-height: 1.5; }
pre { white-space: pre-wrap; word-break: break-word; }

/* Layout */
.app-shell {
  position: relative;
  display: grid;
  grid-template-columns: 240px minmax(620px, 1fr) 280px;
  gap: 20px;
  height: 100vh;
  padding: 20px;
  overflow: hidden;
  background: var(--bg);
}

.sidebar, .stage, .params-panel {
  position: relative;
  z-index: 1;
  min-height: 0;
}
.sidebar, .params-panel {
  display: flex;
  flex-direction: column;
  gap: 16px;
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 4px;
}
.stage {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
  overflow: hidden;
}

/* Base Panel */
.panel,
.brand-card,
.workspace-card,
.mode-card {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--panel);
  box-shadow: var(--shadow-sm);
}
.panel { padding: 18px; overflow: hidden; display: flex; flex-direction: column; gap: 14px; }
.full-panel { min-height: 0; overflow: auto; flex: 1; }

/* Typography */
h1 { font-size: 18px; font-weight: 600; color: var(--text); letter-spacing: -0.01em; }
h2 { font-size: 18px; font-weight: 600; color: var(--text); line-height: 1.4; letter-spacing: -0.01em; }
h3 { font-size: 15px; font-weight: 600; color: var(--text); }
p { color: var(--text-secondary); line-height: 1.5; font-size: 13px; margin: 0; }
.eyebrow {
  margin: 0 0 4px;
  color: var(--muted);
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* Sidebar Components */
.brand-card { display: flex; gap: 12px; align-items: center; padding: 14px 16px; }
.brand-mark {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  border-radius: 8px;
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 700;
  background: var(--cyan);
}

.workspace-card, .mode-card { display: flex; flex-direction: column; gap: 12px; padding: 16px; }
.workspace-card strong { font-size: 13px; font-weight: 600; word-break: break-all; }

.nav-stack { display: flex; flex-direction: column; gap: 12px; }
.nav-group { display: flex; flex-direction: column; gap: 2px; }
.nav-group p {
  margin: 8px 8px 4px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.nav-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  background: transparent;
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 500;
  transition: all 0.15s ease;
}
.nav-item:hover { background: rgba(0,0,0,0.03); color: var(--text); }
.nav-item em,
.status-pill {
  border-radius: 999px;
  color: var(--cyan);
  background: var(--cyan-light);
  padding: 2px 8px;
  font-size: 11px;
  font-weight: 500;
  font-style: normal;
}
.nav-item.active {
  background: var(--cyan-light);
  color: var(--cyan);
  font-weight: 600;
}
.nav-item.disabled { opacity: 0.4; cursor: not-allowed; }
.nav-item.disabled:hover { background: transparent; color: var(--text-secondary); }

/* Stage Header */
.stage-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 16px 20px;
  background: #FFFFFF;
  box-shadow: var(--shadow-sm);
  flex-shrink: 0;
}
.header-actions, .modal-actions, .skill-actions { display: flex; align-items: center; gap: 8px; }

/* Buttons */
.primary, .ghost, .chip-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 500;
  transition: all 0.15s;
}
.primary {
  color: #FFFFFF;
  background: var(--cyan);
  box-shadow: 0 1px 2px rgba(57, 87, 69, 0.2);
}
.primary:hover:not(:disabled) { background: #2F4A39; }
.ghost {
  border: 1px solid var(--line);
  color: var(--text-secondary);
  background: #FFFFFF;
  box-shadow: var(--shadow-sm);
}
.ghost:hover:not(:disabled) { border-color: #D1D5DB; color: var(--text); }
.small { padding: 6px 12px; font-size: 12px; }
.wide { width: 100%; margin-top: 4px; }

/* Pipeline Breadcrumbs */
.pipeline-breadcrumbs {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 4px;
}
.breadcrumb-item {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--text);
  font-size: 14px;
  font-weight: 600;
}
.breadcrumb-item em {
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
  font-weight: 700;
  color: var(--cyan);
  background: var(--cyan-light);
  padding: 2px 6px;
  border-radius: 4px;
  font-style: normal;
}
.breadcrumb-item:not(:last-child)::after {
  content: "→";
  color: var(--muted);
  margin-left: 6px;
  font-weight: 400;
}

/* Layouts */
.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; flex: 1; min-height: 0; }
.module-grid { overflow-y: auto; overflow-x: hidden; padding-right: 4px; display: flex; flex-direction: column; gap: 16px; }

/* Upload Card */
.upload-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.upload-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100px;
  border: 1px dashed #D1D5DB;
  border-radius: var(--radius-sm);
  background: #F9FAFB;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s;
}
.upload-card:hover { border-color: var(--cyan); background: var(--cyan-light); }
.upload-card span { color: var(--cyan); font-size: 20px; font-weight: 300; }
.upload-card p { margin-top: 6px; font-size: 12px; color: var(--text-secondary); font-weight: 500; }

/* Chips */
.chip-row { display: flex; flex-wrap: wrap; gap: 8px; }
.chip-button {
  border: 1px solid var(--line);
  background: #FFFFFF;
  color: var(--text-secondary);
  padding: 6px 12px;
  border-radius: 999px; /* Pills for mode selection */
}
.chip-button:hover:not(.active) { border-color: #D1D5DB; color: var(--text); }
.chip-button.active {
  color: #FFFFFF;
  background: var(--cyan);
  border-color: var(--cyan);
}
.tight { gap: 6px; }

/* Previews & Cards */
.preview-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.scene-tile {
  min-height: 120px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: #FFFFFF;
  padding: 14px;
  transition: all 0.2s;
  box-shadow: var(--shadow-sm);
}
.scene-tile.active {
  border-color: var(--cyan);
  box-shadow: 0 0 0 1px var(--cyan);
  background: #F8FAF9;
}
.scene-tile p { margin-top: 8px; font-size: 12px; }

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120px;
  border: 1px dashed var(--line);
  border-radius: var(--radius-sm);
  color: var(--muted);
  font-size: 13px;
  text-align: center;
  padding: 20px;
}

.result-card, .log-card, .kb-card, .skill-card, .prompt-pack {
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: #FFFFFF;
  padding: 14px;
  box-shadow: var(--shadow-sm);
}
.result-card p, .log-card p, .kb-card p, .skill-card p { margin: 6px 0; font-size: 13px; }
.result-card small, .log-card small, .kb-card small, .skill-card small { color: var(--muted); font-size: 11px; }

.result-card.blocked, .log-card.blocked { border-left: 3px solid #F59E0B; }
.result-card.succeeded, .log-card.succeeded { border-left: 3px solid #10B981; }
.result-card.failed, .log-card.failed { border-left: 3px solid #EF4444; }

/* Lists & Stacks */
.step-list, .knowledge-list, .search-results, .log-list, .skills-grid, .citation-stack {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.step-list article {
  display: flex;
  flex-direction: column;
  gap: 4px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: #FFFFFF;
  padding: 12px 14px;
  box-shadow: var(--shadow-sm);
}
.step-list span { color: var(--cyan); font-family: "JetBrains Mono", monospace; font-size: 11px; font-weight: 600; }

.terminal-panel pre, .article-preview pre {
  max-height: 400px;
  overflow: auto;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: #F9FAFB;
  color: var(--text);
  padding: 16px;
  font-size: 13px;
  line-height: 1.6;
}

/* Forms */
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.field-label, label span, .param-block span {
  display: block;
  margin-bottom: 6px;
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 500;
}
.param-block { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; margin-bottom: 8px; }
.param-block input[type="range"] {
  grid-column: 1 / -1;
  padding: 0;
  box-shadow: none;
  border: none;
  background: transparent;
  accent-color: var(--cyan);
}

/* Misc */
.panel-title { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.error-banner {
  border: 1px solid #FCA5A5;
  border-radius: var(--radius-sm);
  color: #991B1B;
  background: #FEF2F2;
  padding: 12px 16px;
  font-size: 13px;
  font-weight: 500;
}
.selected-citations { display: flex; flex-wrap: wrap; gap: 8px; }
.selected-citations span {
  border-radius: 999px;
  color: var(--cyan);
  background: var(--cyan-light);
  padding: 4px 10px;
  font-size: 12px;
  font-weight: 500;
}

.citation-stack article {
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 10px 12px;
  background: #FFFFFF;
}
.citation-stack strong { color: var(--cyan); font-size: 12px; display: block; margin-bottom: 4px; }

/* Modal */
.modal-backdrop {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: grid;
  place-items: center;
  background: rgba(17, 24, 39, 0.4);
  backdrop-filter: blur(2px);
}
.modal-card {
  width: min(800px, calc(100vw - 48px));
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: #FFFFFF;
  box-shadow: var(--shadow-lg);
  padding: 24px;
}
.modal-actions { justify-content: flex-end; margin-top: 24px; border-top: 1px solid var(--line); padding-top: 16px; }

@media (max-width: 1280px) {
  .app-shell { grid-template-columns: 240px minmax(620px, 1fr); height: auto; min-height: 100vh; overflow: visible; }
  .params-panel { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; }
  .params-panel > section { flex: 1; min-width: 300px; }
  .two-col, .knowledge-layout { grid-template-columns: 1fr; }
}

/* Themes */
.app-shell[data-color="emerald"] {
  --bg: #F3F7F4; --panel: #FFFFFF; --panel-strong: #E6EDE8; --line: #D5E0D8;
  --cyan: #395745; --cyan-light: rgba(57, 87, 69, 0.08);
}
.app-shell[data-color="ocean"] {
  --bg: #F0F7FB; --panel: #FFFFFF; --panel-strong: #E1EFF6; --line: #CCE0EE;
  --cyan: #0284C7; --cyan-light: rgba(2, 132, 199, 0.08);
}
.app-shell[data-color="vintage"] {
  --bg: #F9F5F0; --panel: #FFFFFF; --panel-strong: #F2E8DB; --line: #E5D5C1;
  --cyan: #D97706; --cyan-light: rgba(217, 119, 6, 0.08);
}
.app-shell[data-color="neon"] {
  --bg: #F8F5FA; --panel: #FFFFFF; --panel-strong: #EFE6F6; --line: #E1D0EE;
  --cyan: #C026D3; --cyan-light: rgba(192, 38, 211, 0.08);
}
.app-shell[data-color="lime"] {
  --bg: #F5F9EC; --panel: #FFFFFF; --panel-strong: #EAF3DF; --line: #D9E8C7;
  --cyan: #65A30D; --cyan-light: rgba(101, 163, 13, 0.08);
}
.app-shell[data-color="dusk"] {
  --bg: #FBF7F3; --panel: #FFFFFF; --panel-strong: #F5EAE0; --line: #EBD9CA;
  --cyan: #9A3412; --cyan-light: rgba(154, 52, 18, 0.08);
}
.app-shell[data-color="minimal"] {
  --bg: #F1F4F9; --panel: #FFFFFF; --panel-strong: #E2E8F0; --line: #CBD5E1;
  --cyan: #1D4ED8; --cyan-light: rgba(29, 78, 216, 0.08);
}
.app-shell[data-color="vibrant"] {
  --bg: #F0FAF8; --panel: #FFFFFF; --panel-strong: #DDF3EE; --line: #BBE3D8;
  --cyan: #0D9488; --cyan-light: rgba(13, 148, 136, 0.08);
}
.app-shell[data-color="nature"] {
  --bg: #F2F8F4; --panel: #FFFFFF; --panel-strong: #E2EFE6; --line: #C9E2D2;
  --cyan: #15803D; --cyan-light: rgba(21, 128, 61, 0.08);
}
.app-shell[data-color="arts"] {
  --bg: #F4F1EB; --panel: #FCFAF8; --panel-strong: #EBE6DF; --line: #E2DCD3;
  --text: #3D3935; --text-secondary: #66615B;
  --cyan: #475569; --cyan-light: rgba(71, 85, 105, 0.08);
}
.app-shell[data-color="luxury"] {
  --bg: #F9F9F8; --panel: #FFFFFF; --panel-strong: #F0EFEA; --line: #DFDDD5;
  --cyan: #B45309; --cyan-light: rgba(180, 83, 9, 0.08);
}

.app-shell[data-theme="dark"] {
  --bg: #111827;
  --panel: #1F2937;
  --panel-strong: #374151;
  --line: #374151;
  --text: #F9FAFB;
  --text-secondary: #D1D5DB;
  --muted: #6B7280;
}
.app-shell[data-theme="dark"][data-color="ocean"] { --bg: #0F172A; --panel: #1E293B; --line: #334155; }
.app-shell[data-theme="dark"][data-color="emerald"] { --bg: #0F1A15; --panel: #17261F; --line: #263D32; }
.app-shell[data-theme="dark"][data-color="vintage"] { --bg: #1A1311; --panel: #261D1A; --line: #3D2D29; }
.app-shell[data-theme="dark"][data-color="neon"] { --bg: #15101A; --panel: #22192B; --line: #342642; }
.app-shell[data-theme="dark"][data-color="lime"] { --bg: #111A0C; --panel: #1A2612; --line: #2B3D1F; }
.app-shell[data-theme="dark"][data-color="dusk"] { --bg: #1C1410; --panel: #291D17; --line: #3D2A22; }
.app-shell[data-theme="dark"][data-color="minimal"] { --bg: #0B1121; --panel: #151E32; --line: #243350; }
.app-shell[data-theme="dark"][data-color="vibrant"] { --bg: #0A1716; --panel: #122926; --line: #1D3D39; }
.app-shell[data-theme="dark"][data-color="nature"] { --bg: #0C1A11; --panel: #14291B; --line: #22422C; }
.app-shell[data-theme="dark"][data-color="arts"] { --bg: #1C1B1A; --panel: #292726; --line: #3D3A38; }
.app-shell[data-theme="dark"][data-color="luxury"] { --bg: #1A1918; --panel: #262422; --line: #3D3935; }

.app-shell[data-theme="dark"] input,
.app-shell[data-theme="dark"] textarea {
  background: var(--bg);
}
.app-shell[data-theme="dark"] .stage-header,
.app-shell[data-theme="dark"] .pipeline-strip article,
.app-shell[data-theme="dark"] .scene-tile,
.app-shell[data-theme="dark"] .result-card,
.app-shell[data-theme="dark"] .log-card,
.app-shell[data-theme="dark"] .kb-card,
.app-shell[data-theme="dark"] .skill-card,
.app-shell[data-theme="dark"] .prompt-pack,
.app-shell[data-theme="dark"] .step-list article,
.app-shell[data-theme="dark"] .citation-stack article,
.app-shell[data-theme="dark"] .chip-button,
.app-shell[data-theme="dark"] .ghost,
.app-shell[data-theme="dark"] .modal-card {
  background: var(--panel);
}
.app-shell[data-theme="dark"] .terminal-panel pre,
.app-shell[data-theme="dark"] .article-preview pre,
.app-shell[data-theme="dark"] .upload-card {
  background: var(--bg);
}
.app-shell[data-theme="dark"] .nav-item:hover {
  background: rgba(255,255,255,0.05);
}

/* Theme Modal */
.theme-section {
  margin-top: 20px;
}
.color-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12px;
  margin-top: 12px;
}
.color-card {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 12px;
  background: var(--panel);
  text-align: left;
  transition: all 0.2s;
}
.color-card:hover {
  border-color: var(--cyan);
}
.color-card.active {
  border-color: var(--cyan);
  background: var(--cyan-light);
}
.color-swatch {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  flex-shrink: 0;
}
.color-card strong {
  display: block;
  font-size: 13px;
  color: var(--text);
}
.color-card p {
  font-size: 11px;
  margin-top: 2px;
  color: var(--text-secondary);
}

.log-actions,
.skill-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}
.skill-chip-row span {
  border: 1px solid rgba(57, 87, 69, 0.16);
  border-radius: 999px;
  color: var(--cyan);
  background: rgba(57, 87, 69, 0.08);
  padding: 5px 8px;
  font-size: 11px;
}

.filter-block {
  display: grid;
  gap: 8px;
  margin-top: 12px;
}
.filter-block > span {
  color: var(--muted);
  font-size: 12px;
}

.edit-stack {
  display: grid;
  gap: 10px;
}
.edit-stack textarea {
  min-height: 82px;
}
