{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugu.run/schemas/content-studio/ontology-v1-online-acceptance.schema.json",
  "title": "Content Studio Ontology v1 Online Acceptance Report",
  "type": "object",
  "required": ["ok", "generatedAt", "target", "checks", "sections"],
  "properties": {
    "ok": {
      "const": true
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": ["apiBaseUrl", "tenant", "workspaceId", "releaseId"],
      "properties": {
        "apiBaseUrl": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://(?!localhost(?:[:/?#]|$))(?![^/?#]*\\.localhost(?:[:/?#]|$))(?![^/?#]*\\.local(?:[:/?#]|$))(?!0\\.)(?!10\\.)(?!127\\.)(?!169\\.254\\.)(?!172\\.(?:1[6-9]|2[0-9]|3[0-1])\\.)(?!192\\.168\\.)(?!100\\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.)(?!\\[::1\\])(?!(?:\\[)?f[c-d][0-9a-fA-F]{2}:)(?!\\[fe[89abAB])"
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "releaseId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "sections": {
      "type": "object",
      "required": ["release", "team"],
      "properties": {
        "release": {
          "type": "object",
          "required": ["ok", "release", "package", "checks"],
          "properties": {
            "ok": {
              "const": true
            },
            "release": {
              "type": "object",
              "required": ["id", "status", "approvalStatus"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "const": "published"
                },
                "approvalStatus": {
                  "const": "approved"
                }
              },
              "additionalProperties": true
            },
            "package": {
              "type": "object",
              "required": ["reachable", "publicUrl", "size", "sha256"],
              "properties": {
                "reachable": {
                  "const": true
                },
                "publicUrl": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^https?://(?!localhost(?:[:/?#]|$))(?![^/?#]*\\.localhost(?:[:/?#]|$))(?![^/?#]*\\.local(?:[:/?#]|$))(?!0\\.)(?!10\\.)(?!127\\.)(?!169\\.254\\.)(?!172\\.(?:1[6-9]|2[0-9]|3[0-1])\\.)(?!192\\.168\\.)(?!100\\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.)(?!\\[::1\\])(?!(?:\\[)?f[c-d][0-9a-fA-F]{2}:)(?!\\[fe[89abAB])"
                },
                "size": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                }
              },
              "additionalProperties": true
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/check"
              }
            }
          },
          "additionalProperties": true
        },
        "team": {
          "type": "object",
          "required": ["ok", "workspace", "release", "summaries", "checks"],
          "properties": {
            "ok": {
              "const": true
            },
            "workspace": {
              "type": "object",
              "required": ["actorA", "actorB"],
              "properties": {
                "actorA": {
                  "$ref": "#/$defs/workspace"
                },
                "actorB": {
                  "$ref": "#/$defs/workspace"
                }
              },
              "additionalProperties": true
            },
            "release": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            },
            "summaries": {
              "type": "object",
              "required": ["actorA", "actorB"],
              "properties": {
                "actorA": {
                  "$ref": "#/$defs/teamSummary"
                },
                "actorB": {
                  "$ref": "#/$defs/teamSummary"
                }
              },
              "additionalProperties": true
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/check"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "status", "message"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["passed", "warning", "failed", "skipped"]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "workspace": {
      "type": "object",
      "required": ["id", "currentRevision"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "currentRevision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "teamSummary": {
      "type": "object",
      "required": ["knowledgeMapCount", "buildRunCount", "commandCenterCount", "reviewTaskCount", "executionQueueCount", "actionRecordCount", "releaseCount", "knowledgeMapIds", "buildRunIds", "commandCenterIds", "reviewTaskIds", "executionQueueIds", "actionRecordIds", "actionArtifactRecordCount", "actionArtifactRecordIds", "actionArtifactRefsByRecordId", "releaseIds", "knowledgeMapListComplete", "buildRunListComplete", "commandCenterListComplete", "reviewTaskListComplete", "executionQueueListComplete", "actionRecordListComplete", "releaseListComplete"],
      "properties": {
        "knowledgeMapCount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "buildRunCount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "commandCenterCount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reviewTaskCount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "executionQueueCount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "actionRecordCount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "releaseCount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "knowledgeMapIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "buildRunIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "commandCenterIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "reviewTaskIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "executionQueueIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "actionRecordIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "actionArtifactRecordCount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "actionArtifactRecordIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "actionArtifactRefsByRecordId": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "releaseIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "knowledgeMapListComplete": {
          "const": true
        },
        "buildRunListComplete": {
          "const": true
        },
        "commandCenterListComplete": {
          "const": true
        },
        "reviewTaskListComplete": {
          "const": true
        },
        "executionQueueListComplete": {
          "const": true
        },
        "actionRecordListComplete": {
          "const": true
        },
        "releaseListComplete": {
          "const": true
        }
      },
      "additionalProperties": true
    }
  }
}
